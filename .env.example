# Copy to .env and fill in. Never commit the real .env (see .gitignore).

ATLAS_REDIS_HOST=127.0.0.1
ATLAS_REDIS_PORT=6379
ATLAS_REDIS_DB=0

# quant_db already exists on the server (it's TSE-GOLD-ALGO's live
# database); Atlas uses its own `atlas` schema there, not the trading
# schemas (`hist`, `live`). No password: this connects over the local
# Postgres Unix socket as OS user `quant`, which peer-auths for free --
# Atlas only ever runs as `quant` on this same box.
ATLAS_PG_DSN=postgresql://quant@/quant_db?host=/var/run/postgresql
